# Database
ICA_DATABASE_URL=postgresql+asyncpg://ica:ica_dev@localhost:5432/ica
ICA_REDIS_URL=redis://localhost:6379/0

# CORS
ICA_CORS_ORIGINS=["http://localhost:5173"]

# Debug
ICA_DEBUG=true

# Gemini API (needed for Phase 6 — RAG layer)
GEMINI_API_KEY=your-gemini-api-key-here

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000

# Google OAuth (needed for Addition 3 — Gmail e-commerce worker)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here


