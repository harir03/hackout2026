# ==============================================================================
# AltGrade / Minions Project Environment Configuration (.env.example)
# Copy this file to .env in the root directory or in backend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND - Application Settings
# ------------------------------------------------------------------------------
ICA_DEBUG=True
ICA_CORS_ORIGINS=["http://localhost:5173"]

# ------------------------------------------------------------------------------
# 2. BACKEND - Database & Cache (Optional: Falls back to SQLite / in-memory if not running)
# ------------------------------------------------------------------------------
ICA_DATABASE_URL=postgresql+asyncpg://ica:ica_dev@localhost:5432/ica
ICA_REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. BACKEND - Vapi AI Telephony & Automated Calling Agent
# ------------------------------------------------------------------------------
# Private API Key from Vapi Dashboard (Settings -> API Keys)
VAPI_API_KEY=
ICA_VAPI_API_KEY=

# Twilio / Vapi Phone Number ID (From Vapi Dashboard -> Phone Numbers)
# Format: 36-character UUID (e.g., e4b1c234-5678-4a90-bcde-1234567890ab)
VAPI_PHONE_NUMBER_ID=
ICA_VAPI_PHONE_NUMBER_ID=

# Assistant ID (From Vapi Dashboard -> Assistants)
# Format: 36-character UUID
VAPI_ASSISTANT_ID=
ICA_VAPI_ASSISTANT_ID=

# Default Target Test Phone Number for Outbound Calls (format: +91XXXXXXXXXX)
DEFAULT_TARGET_PHONE=+919876543210

# ------------------------------------------------------------------------------
# 4. BACKEND - Google Gemini AI (For Conversational Advisory & Verification Auditor)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
ICA_GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 5. BACKEND - Account Aggregator / Sandbox Credentials (Optional)
# ------------------------------------------------------------------------------
SANDBOX_API_KEY=
SANDBOX_SECRET=

# ------------------------------------------------------------------------------
# 6. BACKEND - Google OAuth (Optional)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 7. FRONTEND - Client-side Environment Overrides (Vite)
# ------------------------------------------------------------------------------
# Optional phone number override for the "Request On-Call Banking Callback" dialog:
VITE_CALLBACK_PHONE=+919876543210
VITE_DEFAULT_PHONE=+919876543210
