# ==============================================================================
# AltGrade Backend Environment Configuration (.env.example)
# Copy this file to .env and fill in your credentials
# ==============================================================================

# --- Application Settings ---
ICA_DEBUG=True
ICA_CORS_ORIGINS=["http://localhost:5173"]

# --- Database & Cache (Optional: Falls back to SQLite / in-memory if not running) ---
ICA_DATABASE_URL=postgresql+asyncpg://ica:ica_dev@localhost:5432/ica
ICA_REDIS_URL=redis://localhost:6379/0

# --- Vapi AI Telephony & Calling Agent ---
# 1. Private API Key from Vapi Dashboard (Settings -> API Keys)
VAPI_API_KEY=
ICA_VAPI_API_KEY=

# 2. Twilio / Vapi Phone Number ID (From Vapi Dashboard -> Phone Numbers)
# Format: 36-character UUID (e.g., e4b1c234-5678-4a90-bcde-1234567890ab)
VAPI_PHONE_NUMBER_ID=
ICA_VAPI_PHONE_NUMBER_ID=

# 3. Assistant ID (From Vapi Dashboard -> Assistants)
# Format: 36-character UUID
VAPI_ASSISTANT_ID=
ICA_VAPI_ASSISTANT_ID=

# 4. Target Test Phone Number (Optional override: format +91XXXXXXXXXX)
DEFAULT_TARGET_PHONE=+919876543210

# --- Google Gemini AI (For Conversational Credit Advisory) ---
GEMINI_API_KEY=
ICA_GEMINI_API_KEY=

# --- Account Aggregator / Sandbox API Credentials ---
SANDBOX_API_KEY=
SANDBOX_SECRET=

# --- Google OAuth Credentials (Optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
